# ============================================
#  使用 eza 替代 ls（保留 eza 的默认输出）
# ============================================
abbr -a ls 'eza --icons'          # 最直接的替换
abbr -a ll 'eza -l --icons'       # 详细列表（带权限、大小等）
abbr -a la 'eza -la --icons'      # 显示所有文件（含隐藏）
abbr -a tree 'eza --tree' # 树形目录结构

# ============================================
#  使用 bat 替代 cat（保留 bat 的默认输出：分页 + 语法高亮）
# ============================================
abbr -a cat 'bat'         # 直接替换
